# /etc/systemd/system/openmths-bridge.service
# Runs the OpenMT_HS bridge. It opens the real modem port (the "port" and "baud"
# settings in the dashboard) and makes the virtual port the modem host opens.
# Runs as root because it creates the symlink /dev/openmths0.
[Unit]
Description=OpenMT_HS Modem Bridge
After=network.target mariadb.service
Wants=mariadb.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/OpenMT/modem/openmths-bridge
ExecStart=/home/pi/OpenMT/modem/openmths-bridge/build/openmths_bridge -l /dev/openmths0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

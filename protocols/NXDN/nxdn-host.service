# /etc/systemd/system/nxdn-host.service
[Unit]
Description=NXDN Service
After=modem-host.service
Requires=modem-host.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/OpenMT/protocols/NXDN
ExecStart=/home/pi/OpenMT/protocols/NXDN/build/nxdn_host
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

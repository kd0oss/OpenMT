# /etc/systemd/system/fm-host.service
[Unit]
Description=FM Service
After=modem-host.service
Requires=modem-host.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/OpenMT/protocols/FM
ExecStart=/home/pi/OpenMT/protocols/FM/build/fm_host
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

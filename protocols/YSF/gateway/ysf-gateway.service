# /etc/systemd/system/ysf-gateway.service
[Unit]
Description=YSF Gateway
After=ysf-host.service
Requires=ysf-host.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/OpenMT/protocols/YSF
ExecStart=/home/pi/OpenMT/protocols/YSF/gateway/build/ysf_gateway
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
